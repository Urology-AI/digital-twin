# vLLM chat completions endpoint
# e.g. http://your-server:8000/v1/chat/completions
LLM_ENDPOINT=

# Model ID as returned by /v1/models (e.g. gemma4)
LLM_MODEL=gemma4

# Secret token that protects /api/config (updating the LLM endpoint from the UI).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_TOKEN=
