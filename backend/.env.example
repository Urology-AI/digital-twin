# vLLM chat completions endpoint
# e.g. http://your-server:8000/v1/chat/completions
LLM_ENDPOINT=

# Model ID as returned by /v1/models (e.g. gemma4)
LLM_MODEL=gemma4

# Secret token that protects /api/config (updating the LLM endpoint from the UI).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_TOKEN=

# Comma-separated CORS origin allowlist. When unset, the code defaults to the
# two production front-ends + localhost:5173. Set this to ADD origins (it
# replaces the default), e.g. a LAN IP for phone testing via run-dev.sh:
#   ALLOWED_ORIGINS=https://urology-ai.github.io,https://digital-twin.urology.edu.eu.org,http://192.168.1.20:5173
ALLOWED_ORIGINS=
