# URL of your local or hosted LLM (OpenAI-compatible chat completions endpoint)
# e.g. http://localhost:11434/v1/chat/completions  (Ollama)
#      http://192.168.1.10:8000/v1/chat/completions
LLM_ENDPOINT=

# Model name to pass in the request body — leave blank if your endpoint ignores it
LLM_MODEL=

# Secret token that protects /api/config (updating the LLM endpoint from the UI).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_TOKEN=
