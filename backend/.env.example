# URL of your LLM's OpenAI-compatible chat completions endpoint
# e.g. http://localhost:11434/v1/chat/completions  (Ollama)
#      https://your-vllm-host/v1/chat/completions
#      https://api.openai.com/v1/chat/completions
LLM_ENDPOINT=

# API key (leave blank if your instance doesn't require one)
LLM_API_KEY=

# Model name to pass in the request body
LLM_MODEL=gpt-4o
