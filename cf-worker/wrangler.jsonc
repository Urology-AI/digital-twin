{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The app is hosted by the `digital-twin` Worker (config at the repo root),
  // which sits behind Cloudflare Access. This Worker keeps the update feed and
  // download page OUTSIDE Access: the desktop app's updater cannot complete an
  // Access login. It holds RELEASES_READ_PAT. Same code (src/index.ts).
  // Deploy: `cd cf-worker && npx wrangler deploy`.
  "name": "compass-spa-fallback",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // More specific than digital-twin's /* route, so these win.
  "routes": [
    { "pattern": "digital-twin.urology.edu.eu.org/api/updates/*", "zone_name": "urology.edu.eu.org" },
    { "pattern": "digital-twin.urology.edu.eu.org/clinical/download*", "zone_name": "urology.edu.eu.org" }
  ]
}
