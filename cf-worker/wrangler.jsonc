{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "compass-spa-fallback",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // The web app is hosted here on Cloudflare (no GitHub Pages). Build it first
  // from the repo root (`npm run build` → dist/), then `npx wrangler deploy`.
  // No patient data is handled by this Worker — no database, no share links,
  // no AI proxy.
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    // Client-side routes (/clinical/...) get index.html.
    "not_found_handling": "single-page-application",
    // Only these reach src/index.ts; everything else is a static file.
    //  - /api/*             — update feed (holds RELEASES_READ_PAT); other
    //                         /api paths 404 instead of returning the SPA.
    //  - /clinical/download — Worker-rendered desktop-app download page.
    "run_worker_first": ["/api/*", "/clinical/download", "/clinical/download/"]
  },
  // The whole hostname. Cloudflare Access (one application, scoped to
  // /clinical/*) authenticates at the edge before this Worker runs; root
  // ("/") is the public demo.
  "routes": [
    { "pattern": "digital-twin.urology.edu.eu.org/*", "zone_name": "urology.edu.eu.org" }
  ]
  // Secrets — never put them here. Set with `npx wrangler secret put <NAME>`:
  //   RELEASES_READ_PAT             — /api/updates/* (read-only, fine-grained
  //                                   PAT for Urology-AI/digital-twin-releases)
}
