cff-version: 1.2.0
title: "COMPASS: Comprehensive Multi-Modal Prostate Analysis & Surgical Strategy"
message: "If you use COMPASS in your research, please cite as below."
type: software
authors:
  - family-names: "Ajabshir"
    given-names: "Daniel"
    affiliation: "Department of Urology, Icahn School of Medicine at Mount Sinai"
  - family-names: "Tewari"
    given-names: "Ashutosh K."
    affiliation: "Department of Urology, Icahn School of Medicine at Mount Sinai"
