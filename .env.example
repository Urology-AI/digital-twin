# Copy to .env and fill in. Used by `npm run dist:mac` for signing +
# notarization (electron-builder auto-loads .env). .env is gitignored — never commit it.

# Apple Developer ID Application cert. Either leave these unset to use the
# cert already in your login keychain, or point CSC_LINK at an exported .p12.
# CSC_LINK=/absolute/path/to/DeveloperID.p12
# CSC_KEY_PASSWORD=

# Notarization (App Store Connect). APPLE_APP_SPECIFIC_PASSWORD is generated
# at appleid.apple.com → Sign-In and Security → App-Specific Passwords.
APPLE_ID=adidix99@gmail.com
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=PFQPBLNNUE

# GitHub token (Contents: read/write on Urology-AI/digital-twin) for
# `npm run dist:mac -- --publish always`.
GH_TOKEN=
